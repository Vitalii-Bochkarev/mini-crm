# Copy this file to .env and replace every CHANGE_ME value. Never commit .env.
# Use a random POSTGRES_PASSWORD of at least 24 characters. Keep the password in
# BACKEND_CONNECTION_STRING identical; changing credentials after the volume has
# been initialized does not change the existing PostgreSQL user.
COMPOSE_PROJECT_NAME=minicrm
APP_PORT=8080
POSTGRES_DB=minicrm
POSTGRES_USER=minicrm_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_24_CHARACTERS
BACKEND_CONNECTION_STRING=Host=postgres;Port=5432;Database=minicrm;Username=minicrm_app;Password=CHANGE_ME_POSTGRES_PASSWORD_24_CHARACTERS

# Use a random JWT_SECRET_KEY of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES

# Seed passwords apply only while AdminUsers is empty. Changing these values
# later does not update existing users' passwords.
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD
SEED_EDITOR_PASSWORD=CHANGE_ME_EDITOR_PASSWORD
SEED_VIEWER_PASSWORD=CHANGE_ME_VIEWER_PASSWORD
